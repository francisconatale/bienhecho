{
  "scope": "component",
  "isRedesign": true,
  "targetPath": "src/app/(dashboard)/presupuestos/components/pdf-invoice.tsx",
  "targetName": "Invoice PDF Template",
  "painPoints": [
    "Logo con poco aire",
    "Presupuesto ocupa mucho espacio",
    "Total perdido/sin protagonismo",
    "Observaciones mezcladas",
    "Demasiadas líneas en la tabla",
    "Precio unitario irrelevante para el cliente",
    "Bloque de cliente poco moderno"
  ],
  "inspiration": {
    "visual": ["Apple Store", "Revistas Editoriales", "Estudios de Arquitectura"],
    "functional": ["Priorizar el total", "Eliminar columnas innecesarias", "Limpiar líneas de tabla"]
  },
  "brand": {
    "adjectives": ["Minimalista", "Premium", "Limpio", "Moderno"],
    "density": "Spacious",
    "darkMode": false
  },
  "persona": {
    "primary": "Cliente final",
    "context": "desktop-first",
    "keyTasks": ["Ver el total rápidamente", "Entender qué incluye el trabajo", "Leer las observaciones y garantía"]
  },
  "constraints": {
    "mustKeep": ["Descripción, Cantidad, Total"],
    "technical": ["Usar colores del sistema", "Diseño imprimible o exportable a PDF"]
  },
  "framework": "nextjs-app",
  "packageManager": "npm",
  "stylingSystem": "tailwind"
}
